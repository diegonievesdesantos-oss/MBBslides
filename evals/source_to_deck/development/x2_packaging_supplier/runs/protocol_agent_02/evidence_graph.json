    "S:computed": {
      "id": "S:computed",
      "kind": "source",
      "label": "computed"
    },
    "C0001": {
      "id": "C0001",
      "kind": "derived_fact",
      "label": "Full move: 12% on price-eligible spend (25 EUR M less 1.1 EUR M rush freight) saves 2.87 EUR M per year",
      "source": {
        "file": "computed",
        "loc": "F0056 * F0054 / 100"
      }
    },
    "C0002": {
      "id": "C0002",
      "kind": "derived_fact",
      "label": "Procurement's 3.0 EUR M per year overstates the gross price saving by 0.13 EUR M because it applies 12% to rush freight",
      "source": {
        "file": "computed",
        "loc": "F0059 - C0001"
      }
    },
    "C0003": {
      "id": "C0003",
      "kind": "derived_fact",
      "label": "Full move, three-year commitment: gross price saving 2026-2028 less 0.8 EUR M one-off switching cost",
      "source": {
        "file": "computed",
        "loc": "C0001 * 3 - F0065"
      }
    },
    "C0004": {
      "id": "C0004",
      "kind": "derived_fact",
      "label": "Supplier B's two force-majeure stoppages in the last three years (9 and 14 days) would have cost 4.0 EUR M of gross margin with all volume on Supplier B",
      "source": {
        "file": "computed",
        "loc": "F0061 + 2.4"
      }
    },
    "C0005": {
      "id": "C0005",
      "kind": "derived_fact",
      "label": "Average annual gross-margin exposure if Supplier B's stoppage record repeats under single sourcing",
      "source": {
        "file": "computed",
        "loc": "C0004 / 3"
      }
    },
    "C0006": {
      "id": "C0006",
      "kind": "derived_fact",
      "label": "Partial move, Supplier B at 70% of volume with a 9% price reduction: annual saving",
      "source": {
        "file": "computed",
        "loc": "F0056 * F0051 / 100 * F0052 / 100"
      }
    },
    "C0007": {
      "id": "C0007",
      "kind": "derived_fact",
      "label": "Partial move, incumbent kept at 30% of volume with its offered 4% price reduction: annual saving",
      "source": {
        "file": "computed",
        "loc": "F0056 * 30 / 100 * 4 / 100"
      }
    },
    "C0008": {
      "id": "C0008",
      "kind": "derived_fact",
      "label": "Partial move 70/30: total annual price saving",
      "source": {
        "file": "computed",
        "loc": "C0006 + C0007"
      }
    },
    "C0009": {
      "id": "C0009",
      "kind": "derived_fact",
      "label": "Partial move 70/30, 2026-2028: price saving less 0.5 EUR M one-off switching cost",
      "source": {
        "file": "computed",
        "loc": "C0008 * 3 - 0.5"
      }
    },
    "C0010": {
      "id": "C0010",
      "kind": "derived_fact",
      "label": "Full move 2026-2028 after switching cost and a repeat of Supplier B's stoppage record",
      "source": {
        "file": "computed",
        "loc": "C0003 - C0004"
      }
    },
    "C0011": {
      "id": "C0011",
      "kind": "derived_fact",
      "label": "Extra three-year saving of the full move over the 70/30 split, before stoppage risk: the stoppage loss at which the full move stops paying",
      "source": {
        "file": "computed",
        "loc": "C0003 - C0009"
      }
    },
    "C0012": {
      "id": "C0012",
      "kind": "derived_fact",
      "label": "Incremental annual price saving of the full move over the 70/30 split",
      "source": {
        "file": "computed",
        "loc": "C0001 - C0008"
      }
    },
    "C0013": {
      "id": "C0013",
      "kind": "derived_fact",
      "label": "Rush freight in the five 2025 months the invoices flag as 'passed through: our forecast errors'",
      "source": {
        "file": "computed",
        "loc": "F0010 + F0022 + F0034 + F0038 + F0042"
      }
    },
    "C0014": {
      "id": "C0014",
      "kind": "derived_fact",
