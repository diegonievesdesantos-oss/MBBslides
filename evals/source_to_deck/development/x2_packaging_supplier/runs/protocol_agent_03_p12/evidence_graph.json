        "loc": "C0004 * 3"
      }
    },
    "H1": {
      "id": "H1",
      "kind": "hypothesis",
      "label": "Management view: moving 100% of packaging to Supplier B saves 3.0 EUR M a year",
      "status": "rejected"
    },
    "H2": {
      "id": "H2",
      "kind": "hypothesis",
      "label": "The proposal applies the 12% to the full 25 EUR M, including 1.1 EUR M of rush freight that no unit-price reduction touches",
      "status": "supported"
    },
    "H3": {
      "id": "H3",
      "kind": "hypothesis",
      "label": "Supplier B's single-plant risk erodes a material part of the saving once volume is concentrated",
      "status": "supported"
    },
    "H4": {
      "id": "H4",
      "kind": "hypothesis",
      "label": "A 70/30 split (Supplier B / incumbent) delivers more risk-adjusted value than 100% Supplier B",
      "status": "rejected"
    },
    "H5": {
      "id": "H5",
      "kind": "hypothesis",
      "label": "Keeping the status quo (30% Supplier B) is the safe, no-cost option",
      "status": "rejected"
    },
    "H6": {
      "id": "H6",
      "kind": "hypothesis",
      "label": "The incumbent can absorb a Supplier B stoppage, so concentration risk is mitigable",
      "status": "unresolved"
    },
    "I1": {
      "id": "I1",
      "kind": "insight",
      "label": "The €3.0M a year claim is 12% of the full €25M spend, but €1.1M of that spend is rush freight that no unit-price cut touches, so the gross price lever is €2.87M a year"
    },
    "I2": {
      "id": "I2",
      "kind": "insight",
      "label": "Rush freight is our problem, not the supplier's: €0.65M of the €1.1M falls in five months flagged as our forecast errors, so it survives any supplier choice"
    },
    "I3": {
      "id": "I3",
      "kind": "insight",
      "label": "If Supplier B's last two stoppages recur, they cost €4.0M over 2026-2028 at full exposure, 46% of the €8.6M three-year gross saving of full consolidation"
    },
    "I4": {
      "id": "I4",
      "kind": "insight",
      "label": "Costed on the same three components (price, switching, stoppage risk by Supplier B share), full consolidation nets €3.8M over three years, against €2.08M for a 70/30 split and a net cost of €1.2M for the status quo"
    },
    "I5": {
      "id": "I5",
      "kind": "insight",
      "label": "Full consolidation stays ahead of a 70/30 split unless three-year stoppage cost exceeds €9.76M, 2.4x history; but it leaves no second source, and the incumbent can cover 60% of volume only at two weeks' notice"
    },
    "I6": {
      "id": "I6",
      "kind": "insight",
      "label": "The real saving of full consolidation is €1.27M a year (€3.8M over three years), not €3.0M a year (€9.0M): €5.2M of the claimed saving will not materialise"
    },
    "GT": {
      "id": "GT",
      "kind": "governing_thought",
      "label": "Approve full consolidation on Supplier B, but at an expected saving of about €3.8M over 2026-2028 (€1.27M a year), not the €9.0M claimed, and sign only once a continuity safeguard covers its single plant"
    },
    "K1": {
      "id": "K1",
      "kind": "key_line",
      "label": "The €3.0M a year claim is overstated: the 12% applies to €23.9M, not €25M, and the case omits switching cost and stoppage risk"
    },
    "K2": {
      "id": "K2",
      "kind": "key_line",
      "label": "Supplier B's single plant is the largest cost in the case: a repeat of its two stoppages costs €4.0M over three years at full exposure, and it hits every option by its Supplier B share"
    },
    "K3": {
      "id": "K3",
      "kind": "key_line",
      "label": "On the same basis full consolidation still wins: €3.8M net over three years against €2.08M for 70/30 and a €1.2M net cost for the status quo, and it stays ahead unless stoppages cost 2.4x history"
    },
    "K4": {
      "id": "K4",
      "kind": "key_line",
      "label": "Approve full consolidation with the budget restated to €3.8M and the three-year commitment gated on a continuity safeguard"
    },
    "SL:S1": {
      "id": "SL:S1",
      "kind": "slide",
      "label": "Packaging supplier consolidation: approve Supplier B, at the real saving",
      "priority": "core",
      "reason": "Board deck opener"
    },
    "SL:S2": {
      "id": "SL:S2",
      "kind": "slide",
      "label": "Approve full consolidation on Supplier B at €3.8M over 2026-2028, not €9.0M, gated on a continuity safeguard",
      "priority": "core",
      "reason": "The board reads the answer and the ask on one page"
    },
    "SL:S3": {
      "id": "SL:S3",
      "kind": "slide",
      "label": "The €3.0M a year claim falls to €1.27M once rush freight, switching and stoppage risk are counted",
      "priority": "core",
      "reason": "Bridges the claimed to the real saving; the core of 'what is the real saving'"
    },
    "SL:S4": {
      "id": "SL:S4",
      "kind": "slide",
      "label": "Supplier B's single plant is the biggest cost: two repeat stoppages would take €4.0M, 46% of the three-year gross saving",
      "priority": "core",
      "reason": "The risk the proposal omits; it drives the option comparison"
    },
    "SL:S5": {
      "id": "SL:S5",
      "kind": "slide",
      "label": "Full consolidation beats a 70/30 split by €1.73M over three years even after charging each option its share of stoppage risk",
      "priority": "core",
      "reason": "The decision itself: options costed on identical components"
    },
    "SL:S6": {
      "id": "SL:S6",
      "kind": "slide",
      "label": "The ranking flips only if stoppages cost more than €9.76M over three years, 2.4x history",
      "priority": "support",
      "reason": "Answers the red-team objection that a two-event history is thin"
    },
    "SL:S7": {
      "id": "SL:S7",
      "kind": "slide",
      "label": "Approve the move, restate the budget to €3.8M, and sign only once a continuity safeguard is in place",
      "priority": "core",
      "reason": "Asks, gates and KPIs the board approves today"
    },
    "SL:S8": {
      "id": "SL:S8",
      "kind": "slide",
      "label": "Appendix: €0.65M of the €1.1M rush freight comes from our own forecast errors, a separate lever",
      "priority": "appendix",
      "reason": "Explains why rush freight is excluded from every option and points to a separate saving"
    }
  },
