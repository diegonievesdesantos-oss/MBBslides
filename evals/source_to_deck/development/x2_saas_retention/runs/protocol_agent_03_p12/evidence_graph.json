    "H4": {
      "id": "H4",
      "kind": "hypothesis",
      "label": "Expansion ARR fell for the same reason as churn: customers who never fully implement the product do not expand",
      "status": "unresolved"
    },
    "H5": {
      "id": "H5",
      "kind": "hypothesis",
      "label": "Hiring 30 account executives in Q1 2026 will add 9 EUR M of new ARR in 2026, as the CRO states",
      "status": "rejected"
    },
    "I1": {
      "id": "I1",
      "kind": "insight",
      "label": "ARR growth fell from 25% to 9.2% because net new ARR fell by €5.6M (€10.4M to €4.8M): churned ARR rose by €4.5M (€3.3M to €7.8M) and expansion fell by €1.3M, while new ARR rose by €0.2M (€9.4M to €9.6M)."
    },
    "I2": {
      "id": "I2",
      "kind": "insight",
      "label": "The sales engine did not weaken: pipeline created rose from €38.9M to €45.9M, the win rate held between 23% and 24% every quarter and deals won rose from 175 to 193; the slowdown did not come from new sales, so it cannot come from price competition in new deals."
    },
    "I3": {
      "id": "I3",
      "kind": "insight",
      "label": "Churn is a first-year problem: customers onboarded in the previous 12 months churned 26% of ARR versus 9% for mature customers; they held 35% of opening ARR but 60.3% of churned ARR, and first-year churn rose 14 PP from 12% in 2024."
    },
    "I4": {
      "id": "I4",
      "kind": "insight",
      "label": "The onboarding cut is the most likely cause: the team went from 14 to 6 people in February 2025, median time to first value rose from 21 to 48 days, and 58% of the 64 churned customers interviewed never fully implemented the product versus 17% who moved to a competitor and 14% who cite price."
    },
    "I5": {
      "id": "I5",
      "kind": "insight",
      "label": "The onboarding saving was a false economy: it saved €0.8M a year while first-year churn above the 2024 rate cost about €2.5M of ARR in 2025."
    },
    "I6": {
      "id": "I6",
      "kind": "insight",
      "label": "The CRO's €9M is the full-productivity run-rate of 30 AEs at €300k each; with a 9-month ramp, a Q1 hire delivers about €5.6M of new ARR in 2026, €3.4M short of the promise, for €3.6M a year."
    },
    "I7": {
      "id": "I7",
      "kind": "insight",
      "label": "New customers won by extra AEs would enter an onboarding that loses 26% of first-year ARR, so hiring before fixing onboarding buys ARR that leaks within a year."
    },
    "I8": {
      "id": "I8",
      "kind": "insight",
      "label": "Expansion ARR fell by €1.3M (€4.3M to €3.0M); a link to poor implementation is plausible but untested, so the expansion lever is an upper bound."
    },
    "GT": {
      "id": "GT",
      "kind": "governing_thought",
      "label": "ARR growth fell to 9.2% because rising churn and weaker expansion cut net new ARR by €5.6M while new sales held; the 2026 budget should first reverse the €0.8M onboarding cut, which lost about €2.5M of ARR, and release the €3.6M AE hire only once first-year churn recovers."
    },
    "K1": {
      "id": "K1",
      "kind": "key_line",
      "label": "Net new ARR fell by €5.6M because churn rose by €4.5M and expansion fell by €1.3M; new sales held, win rate stayed between 23% and 24%."
    },
    "K2": {
      "id": "K2",
      "kind": "key_line",
      "label": "First-year churn more than doubled from 12% to 26% after the onboarding team was cut from 14 to 6; the €0.8M saving cost about €2.5M of ARR."
    },
    "K3": {
      "id": "K3",
      "kind": "key_line",
      "label": "The 30-AE plan books €9M that the 9-month ramp cannot deliver in 2026 (about €5.6M) and feeds new customers into an onboarding that loses 26% of them."
    },
    "K4": {
      "id": "K4",
      "kind": "key_line",
      "label": "Restore onboarding now and release AE hiring at a retention gate: retention levers worth up to €3.8M, with the €1.8M gap closed by gated AE hiring."
    },
    "SL:S1": {
      "id": "SL:S1",
      "kind": "slide",
      "label": "Growth slowed because churn rose, not because sales slowed: restore onboarding now (€0.8M) and gate the €3.6M AE hire on retention",
      "priority": "core",
      "reason": "Board reads the answer and the asks on one page"
    },
    "SL:S2": {
      "id": "SL:S2",
      "kind": "slide",
      "label": "Net new ARR fell by €5.6M: churn rose by €4.5M and expansion fell by €1.3M while new ARR grew by €0.2M",
      "priority": "core",
      "reason": "The single exhibit that relocates the problem from sales to retention"
    },
    "SL:S3": {
      "id": "SL:S3",
      "kind": "slide",
      "label": "The sales engine held: pipeline rose from €38.9M to €45.9M, win rate stayed between 23% and 24%, and only 17% of churned customers left for a competitor",
      "priority": "core",
      "reason": "The current plan rests on this diagnosis; the board needs to see it tested"
    },
    "SL:S4": {
      "id": "SL:S4",
      "kind": "slide",
      "label": "First-year customers churned 26% of ARR versus 9% for mature ones and produced 60.3% of churned ARR",
      "priority": "core",
      "reason": "Shows the problem is onboarding of new customers, not the installed base"
    },
    "SL:S5": {
      "id": "SL:S5",
      "kind": "slide",
      "label": "Cutting onboarding from 14 to 6 saved €0.8M but time to first value rose from 21 to 48 days and excess first-year churn cost about €2.5M",
      "priority": "core",
      "reason": "Turns the diagnosis into a costed, reversible decision"
    },
    "SL:S6": {
      "id": "SL:S6",
      "kind": "slide",
      "label": "The CRO's €9M is a full-productivity run-rate: assuming a linear 9-month ramp, 30 AEs add about €5.6M in 2026, €3.4M short, for €3.6M a year",
      "priority": "core",
      "reason": "The board is asked to approve this number"
    },
    "SL:S7": {
      "id": "SL:S7",
      "kind": "slide",
      "label": "Restoring onboarding first costs €0.8M against €3.6M for the CRO plan and €4.4M for doing both, and removes the €2.5M churn exposure",
      "priority": "core",
      "reason": "Same-basis comparison of the three options the board can choose"
    },
    "SL:S8": {
      "id": "SL:S8",
      "kind": "slide",
      "label": "Retention levers recover up to €3.8M of the €5.6M lost; gated AE hiring closes the remaining €1.8M, mostly in 2027",
      "priority": "core",
      "reason": "Reconciles levers to the target and states the gap honestly"
    },
    "SL:S9": {
      "id": "SL:S9",
      "kind": "slide",
      "label": "Board asks today: approve €0.8M for onboarding, reject the Q1 30-AE hire, pre-approve the €3.6M AE envelope behind a Q2 retention gate",
      "priority": "core",
      "reason": "Turns the recommendation into decisions, a gate and tracking KPIs"
    }
  },
