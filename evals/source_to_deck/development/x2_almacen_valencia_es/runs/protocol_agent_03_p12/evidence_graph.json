        "file": "computed",
        "loc": "C0014 - C0008"
      }
    },
    "H1": {
      "id": "H1",
      "kind": "hypothesis",
      "label": "Cerrar Valencia ahorra 4,1 M€ al año (tesis de Operaciones)",
      "status": "rejected"
    },
    "H2": {
      "id": "H2",
      "kind": "hypothesis",
      "label": "Madrid tiene capacidad libre suficiente para absorber los pedidos de Levante",
      "status": "rejected"
    },
    "H3": {
      "id": "H3",
      "kind": "hypothesis",
      "label": "El coste de cierre es de 1,5 M€",
      "status": "rejected"
    },
    "H4": {
      "id": "H4",
      "kind": "hypothesis",
      "label": "El servicio al cliente de Levante no se verá afectado",
      "status": "rejected"
    },
    "H5": {
      "id": "H5",
      "kind": "hypothesis",
      "label": "Mantener Valencia y renovar el alquiler con descuento es más barato que cerrar",
      "status": "supported"
    },
    "H6": {
      "id": "H6",
      "kind": "hypothesis",
      "label": "Con el crecimiento previsto de 2026, el problema de la red es capacidad en Madrid y no exceso de almacenes",
      "status": "supported"
    },
    "I1": {
      "id": "I1",
      "kind": "insight",
      "label": "Los 4,1 M€ de ahorro incluyen 1,5 M€ de coste variable que no desaparece: se traslada a Madrid al mismo coste de 4 € por pedido. Lo único que se elimina es el coste fijo de 2,6 M€, que el transporte desde Madrid (1,9 M€) y el turno adicional (0,6 M€) consumen casi entero: quedan 0,1 M€ al año, y tras horas extra el saldo es de prácticamente nulo (-0,01 M€)."
    },
    "I2": {
      "id": "I2",
      "kind": "insight",
      "label": "Madrid no puede absorber Levante con su capacidad actual: Levante son 375 mil pedidos y Madrid tiene 300 mil libres, faltan 75 mil. El cierre obliga a un turno adicional y, con la previsión de 2026, dejaría Madrid al 97% de utilización con turno."
    },
    "I3": {
      "id": "I3",
      "kind": "insight",
      "label": "El cierre cuesta 3,2 M€ según Finanzas, no 1,5 M€: Operaciones omite la penalización del alquiler (1,7 M€ de diferencia). Con un ahorro recurrente de 0,1 M€ como máximo, ese coste no se recupera en el horizonte."
    },
    "I4": {
      "id": "I4",
      "kind": "insight",
      "label": "El cierre degrada el servicio: el 34% de los pedidos de Levante pasaría de 24 a 48 horas, y el 40% de los clientes con entrega a 48 horas se plantearía cambiar de proveedor. Sobre 74 M€ de ingresos de Levante y un margen del 22%, hasta 10,1 M€ de ingresos y 2,2 M€ de margen al año quedarían en riesgo, más que cualquier ahorro del cierre."
    },
    "I5": {
      "id": "I5",
      "kind": "insight",
      "label": "Renovar el alquiler de Valencia, que vence en diciembre de 2026, con el 25% de descuento ofrecido ahorra 0,3 M€ al año (1,5 M€ en cinco años), sin coste de cierre ni riesgo de servicio: 0,31 M€ al año mejor que cerrar antes de contar el riesgo comercial."
    },
    "I6": {
      "id": "I6",
      "kind": "insight",
      "label": "Con el +6% previsto para 2026, Madrid llegaría al 88% de utilización aun sin cerrar Valencia y entraría en horas extra (0,05 M€); cerrar Valencia elevaría ese sobrecoste a 0,2 M€. El reto de la red es capacidad en Madrid, no un almacén sobrante."
    },
    "GT": {
      "id": "GT",
      "kind": "governing_thought",
      "label": "Rechazar el cierre de Valencia: el ahorro recurrente real es de 0,1 M€ al año como máximo (no 4,1 M€), el cierre cuesta 3,2 M€ y pone en riesgo hasta 2,2 M€ de margen anual; renovar el alquiler con un 25% de descuento ahorra 0,3 M€ al año sin riesgo de servicio."
    },
    "K1": {
      "id": "K1",
      "kind": "key_line",
      "label": "El ahorro prometido no existe: de 4,1 M€ quedan 0,1 M€ al año antes de horas extra, frente a un coste de cierre de 3,2 M€ que no se recupera"
    },
    "K2": {
      "id": "K2",
      "kind": "key_line",
      "label": "El cierre añade riesgo: Madrid no tiene capacidad para Levante y hasta 2,2 M€ de margen anual quedan expuestos por el paso a 48 horas"
    },
    "K3": {
