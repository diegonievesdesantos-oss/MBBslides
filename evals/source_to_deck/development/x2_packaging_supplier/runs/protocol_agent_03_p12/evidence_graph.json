    "C0004": {
      "id": "C0004",
      "kind": "derived_fact",
      "label": "Overstatement of the proposal's 3.0 EUR M annual saving (12% applied to rush freight)",
      "source": {
        "file": "computed",
        "loc": "F0059 - C0003"
      }
    },
    "C0005": {
      "id": "C0005",
      "kind": "derived_fact",
      "label": "Annual price saving of 70/30: 9% on 70% of volume with Supplier B plus incumbent's 4% on the 30% it keeps, on 23.9 EUR M",
      "source": {
        "file": "computed",
        "loc": "F0056 * (F0051 * F0052 + 30 * 4) / 10000"
      }
    },
    "C0006": {
      "id": "C0006",
      "kind": "derived_fact",
      "label": "Three-year (2026-2028) price saving of 100% Supplier B",
      "source": {
        "file": "computed",
        "loc": "C0003 * 3"
      }
    },
    "C0007": {
      "id": "C0007",
      "kind": "derived_fact",
      "label": "Three-year (2026-2028) price saving of 70/30",
      "source": {
        "file": "computed",
        "loc": "C0005 * 3"
      }
    },
    "C0008": {
      "id": "C0008",
      "kind": "derived_fact",
      "label": "Expected three-year stoppage cost at 100% exposure if the last three years' stoppages (9 and 14 days) recur (2.4 EUR M is the 14-day cost stated in F0062)",
      "source": {
        "file": "computed",
        "loc": "F0061 + 2.4"
      }
    },
    "C0009": {
      "id": "C0009",
      "kind": "derived_fact",
      "label": "Expected three-year stoppage cost with 70% of volume on Supplier B",
      "source": {
        "file": "computed",
        "loc": "C0008 * 0.7"
      }
    },
    "C0010": {
      "id": "C0010",
      "kind": "derived_fact",
      "label": "Expected three-year stoppage cost with 30% of volume on Supplier B (status quo)",
      "source": {
        "file": "computed",
        "loc": "C0008 * 0.3"
      }
    },
    "C0011": {
      "id": "C0011",
      "kind": "derived_fact",
      "label": "Three-year net value of 100% Supplier B: price saving minus 0.8 EUR M switching minus expected stoppage cost",
      "source": {
        "file": "computed",
        "loc": "C0006 - 0.8 - C0008"
      }
    },
    "C0012": {
      "id": "C0012",
      "kind": "derived_fact",
      "label": "Three-year net value of 70/30: price saving minus 0.5 EUR M switching minus expected stoppage cost",
      "source": {
        "file": "computed",
        "loc": "C0007 - 0.5 - C0009"
      }
    },
    "C0013": {
      "id": "C0013",
      "kind": "derived_fact",
      "label": "Three-year net value of the status quo: no price saving, no switching, expected stoppage cost on 30%",
      "source": {
        "file": "computed",
        "loc": "0 - C0010"
      }
    },
    "C0014": {
      "id": "C0014",
      "kind": "derived_fact",
      "label": "Advantage of 100% Supplier B over 70/30 over three years",
      "source": {
        "file": "computed",
        "loc": "C0011 - C0012"
      }
    },
    "C0015": {
      "id": "C0015",
      "kind": "derived_fact",
      "label": "Three-year full-exposure stoppage cost at which 70/30 would match 100% Supplier B (break-even)",
      "source": {
        "file": "computed",
        "loc": "(C0006 - C0007 - 0.3) / 0.3"
      }
    },
    "C0016": {
      "id": "C0016",
      "kind": "derived_fact",
      "label": "Break-even stoppage cost as a multiple of the historical 4.0 EUR M",
      "source": {
        "file": "computed",
        "loc": "C0015 / C0008"
      }
    },
    "C0017": {
      "id": "C0017",
      "kind": "derived_fact",
      "label": "Three-year saving claimed by the proposal (3.0 EUR M a year)",
      "source": {
        "file": "computed",
        "loc": "F0059 * 3"
      }
    },
    "C0018": {
      "id": "C0018",
      "kind": "derived_fact",
      "label": "Gap between the claimed three-year saving and the risk-adjusted net of 100% Supplier B",
      "source": {
        "file": "computed",
        "loc": "C0017 - C0011"
      }
    },
    "C0019": {
      "id": "C0019",
      "kind": "derived_fact",
      "label": "Risk-adjusted annual net saving of 100% Supplier B (three-year net divided by three)",
      "source": {
        "file": "computed",
        "loc": "C0011 / 3"
      }
    },
    "C0020": {
      "id": "C0020",
      "kind": "derived_fact",
      "label": "Rush freight in the five months flagged as caused by our forecast errors",
      "source": {
        "file": "computed",
        "loc": "sum(F0010,F0022,F0034,F0038,F0042)"
      }
    },
    "C0021": {
      "id": "C0021",
      "kind": "derived_fact",
      "label": "Expected stoppage cost as a share of the three-year gross price saving of 100% Supplier B",
      "source": {
        "file": "computed",
        "loc": "C0008 / C0006 * 100"
      }
    },
    "C0022": {
      "id": "C0022",
      "kind": "derived_fact",
      "label": "Advantage of 100% Supplier B over the status quo over three years",
      "source": {
        "file": "computed",
        "loc": "C0011 - C0013"
      }
    },
    "C0023": {
      "id": "C0023",
      "kind": "derived_fact",
      "label": "Three-year overstatement from applying the 12% to rush freight",
      "source": {
