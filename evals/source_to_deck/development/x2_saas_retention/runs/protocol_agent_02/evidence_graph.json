    "H1": {
      "id": "H1",
      "kind": "hypothesis",
      "label": "Management view (CRO): growth slowed because a new competitor is undercutting us on price",
      "status": "rejected"
    },
    "H2": {
      "id": "H2",
      "kind": "hypothesis",
      "label": "Growth slowed because churned ARR surged, not because acquisition fell",
      "status": "supported"
    },
    "H3": {
      "id": "H3",
      "kind": "hypothesis",
      "label": "The February 2025 onboarding cut drove the first-year churn spike (customers never reach value)",
      "status": "supported"
    },
    "H4": {
      "id": "H4",
      "kind": "hypothesis",
      "label": "Sales capacity is the binding constraint on growth (not enough account executives)",
      "status": "unresolved"
    },
    "H5": {
      "id": "H5",
      "kind": "hypothesis",
      "label": "The 30-AE plan will add €9M of new ARR in 2026",
      "status": "rejected"
    },
    "H6": {
      "id": "H6",
      "kind": "hypothesis",
      "label": "The expansion decline has the same root cause as first-year churn (customers who never implemented do not expand)",
      "status": "unresolved"
    },
    "I1": {
      "id": "I1",
      "kind": "insight",
      "label": "Net new ARR fell €5.6M (from €10.4M to €4.8M) and higher churn explains 80.4% of the fall: churned ARR rose €4.5M (from 3.3 to 7.8) while new-logo ARR rose €0.2M"
    },
    "I2": {
      "id": "I2",
      "kind": "insight",
      "label": "Expansion ARR fell €1.3M (from 4.3 to 3.0), the second leak in the bridge; new and expansion together barely moved while churn more than doubled"
    },
    "I3": {
      "id": "I3",
      "kind": "insight",
      "label": "The sales engine did not break: pipeline created grew 18.0% (€38.9M to €45.9M), deals won rose from 175 to 193 and win rate held at 23% to 24%"
    },
    "I4": {
      "id": "I4",
      "kind": "insight",
      "label": "Price pressure is real but marginal: average new ARR per deal slipped from €53.7k to €49.7k and price is cited in 34% of lost deals, yet only 31% of churned customers cite a competitor or price"
    },
    "I5": {
      "id": "I5",
      "kind": "insight",
      "label": "The leak is concentrated in new customers: customers onboarded in the previous 12 months churned 26% in 2025 versus 12% in 2024 (+14 pp), and supplied 60.3% of churned ARR (€4.7M of €7.8M) while mature customers churned 9%"
    },
    "I6": {
      "id": "I6",
      "kind": "insight",
      "label": "The first-year churn spike follows the February 2025 onboarding cut that saved €0.8M a year: median time to first value rose from 21 to 48 days and 58% of churned customers say they never fully implemented; excess first-year churn above the 2024 rate cost €2.5M of ARR"
    },
    "I7": {
      "id": "I7",
      "kind": "insight",
      "label": "The CRO's €9M equals 30 AEs at full €300k productivity for a whole year; with a 9-month ramp, Q1 hires deliver at most €4.5M in 2026, a €4.5M shortfall, for €3.6M a year"
    },
    "I8": {
      "id": "I8",
      "kind": "insight",
      "label": "A retention-first plan costs €2.0M a year (restore onboarding for €0.8M plus 10 AEs for €1.2M), frees €1.6M versus the CRO plan, and identifies up to €5.3M of the €5.6M needed to restore 2024 net new ARR"
    },
    "GT": {
      "id": "GT",
      "kind": "governing_thought",
      "label": "Growth slowed because we lost customers, not deals: higher churn explains 80.4% of the €5.6M fall in net new ARR, concentrated in first-year customers after the onboarding cut. Fund retention first (restore onboarding, €0.8M) with a gated first wave of 10 AEs, for €2.0M a year instead of €3.6M, rather than 30 AEs whose 2026 yield is at most an estimated €4.5M, not the €9M promised."
    },
    "K1": {
      "id": "K1",
      "kind": "key_line",
      "label": "Growth slowed because churn more than doubled to €7.8M and explains 80.4% of the €5.6M fall in net new ARR; the sales engine kept growing pipeline 18.0% at a stable win rate"
    },
    "K2": {
      "id": "K2",
      "kind": "key_line",
      "label": "The leak sits in the first year: new customers churned 26% versus 12% in 2024 after onboarding was cut to save €0.8M, costing €2.5M of ARR"
    },
    "K3": {
      "id": "K3",
      "kind": "key_line",
      "label": "The 30-AE plan does not hold: with a 9-month ramp it yields at most €4.5M in 2026, not €9M, for €3.6M a year, and pours new customers into the leak"
    },
    "K4": {
      "id": "K4",
      "kind": "key_line",
      "label": "A retention-first plan for €2.0M a year identifies up to €5.3M of the €5.6M needed, with AE wave 2 gated on retention"
    },
    "SL:S1": {
      "id": "SL:S1",
      "kind": "slide",
      "label": "2026 growth investment: fix retention before adding sales capacity",
      "priority": "core",
      "reason": "Board deck opener naming the decision"
    },
    "SL:S2": {
      "id": "SL:S2",
      "kind": "slide",
      "label": "Churn, not sales, cut net new ARR by €5.6M; we recommend a retention-first plan at an estimated €2.0M a year instead of €3.6M for 30 AEs",
      "priority": "core",
      "reason": "Gives the board the answer and the asks on one page"
    },
    "SL:S3": {
      "id": "SL:S3",
      "kind": "slide",
      "label": "Higher churn explains 80.4% of the €5.6M fall in net new ARR; new-logo ARR still grew €0.2M",
      "priority": "core",
      "reason": "The core diagnosis: the bridge shows the problem is churn and expansion, not acquisition"
    },
    "SL:S4": {
      "id": "SL:S4",
      "kind": "slide",
      "label": "The sales engine did not break: pipeline grew 18.0%, deals won rose from 175 to 193 and only 31% of churned customers cite a competitor or price",
      "priority": "core",
      "reason": "Rejects the management hypothesis that the CRO plan rests on"
    },
    "SL:S5": {
      "id": "SL:S5",
      "kind": "slide",
      "label": "First-year customers churned 26% versus 12% in 2024 and supplied 60.3% of churned ARR; mature customers churned 9%",
      "priority": "core",
      "reason": "Shows the leak is in the first year, which points to onboarding"
    },
    "SL:S6": {
      "id": "SL:S6",
      "kind": "slide",
      "label": "Cutting onboarding saved €0.8M but more than doubled time to first value (21 to 48 days) and cost about €2.5M of ARR",
      "priority": "core",
      "reason": "Root cause and its economics: the lever L1"
    },
    "SL:S7": {
      "id": "SL:S7",
      "kind": "slide",
      "label": "30 AEs hired in Q1 deliver at most an estimated €4.5M in 2026, not €9M, because new AEs need 9 months to reach €300k (assumes a linear ramp)",
      "priority": "core",
      "reason": "The board is asked to approve this plan; it must see that the promise does not hold"
    },
    "SL:S8": {
      "id": "SL:S8",
      "kind": "slide",
      "label": "Retention first costs an estimated €2.0M versus €3.6M and identifies up to €5.3M of the €5.6M needed, leaving an estimated €0.3M gap (levers are upper bounds)",
      "priority": "core",
      "reason": "Costed options and the lever bridge to the target, with the gap stated"
    },
    "SL:S9": {
      "id": "SL:S9",
      "kind": "slide",
      "label": "Decisions today: reject 30 AEs, approve €0.8M for onboarding and a first wave of 10 AEs (our sizing), hold an estimated €1.6M until first-year churn is back at 12%",
      "priority": "core",
      "reason": "Closes with what the board approves today and how it will be governed"
    }
  },
