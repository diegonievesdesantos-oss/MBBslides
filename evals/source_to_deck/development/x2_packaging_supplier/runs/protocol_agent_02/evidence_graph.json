      "source": {
        "file": "computed",
        "loc": "C0013 / 1.1 * 100"
      }
    },
    "C0015": {
      "id": "C0015",
      "kind": "derived_fact",
      "label": "Gap between procurement's claimed 3.0 EUR M per year and the recommended 70/30 split's annual saving",
      "source": {
        "file": "computed",
        "loc": "F0059 - C0008"
      }
    },
    "C0016": {
      "id": "C0016",
      "kind": "derived_fact",
      "label": "Cost over 2026-2028 of keeping procurement's full-move plan instead of the 70/30 split, if Supplier B's stoppage record repeats",
      "source": {
        "file": "computed",
        "loc": "C0009 - C0010"
      }
    },
    "H1": {
      "id": "H1",
      "kind": "hypothesis",
      "label": "Moving 100% of packaging to Supplier B saves 3.0 EUR M per year (procurement's case, management belief)",
      "status": "rejected"
    },
    "H2": {
      "id": "H2",
      "kind": "hypothesis",
      "label": "The 12% price reduction applies to the full 25 EUR M packaging spend",
      "status": "rejected"
    },
    "H3": {
      "id": "H3",
      "kind": "hypothesis",
      "label": "Single-sourcing on Supplier B's single plant creates a continuity risk as large as the extra saving the full move brings",
      "status": "supported"
    },
    "H4": {
      "id": "H4",
      "kind": "hypothesis",
      "label": "A 70/30 split between Supplier B and the incumbent captures most of the saving at lower risk and is the best risk-adjusted option",
      "status": "supported"
    },
    "H5": {
      "id": "H5",
      "kind": "hypothesis",
      "label": "Rush freight is an incumbent performance problem that would disappear by moving volume to Supplier B",
      "status": "rejected"
    },
    "H6": {
      "id": "H6",
      "kind": "hypothesis",
      "label": "The incumbent could backstop Supplier B quickly enough in a stoppage if all volume moved to Supplier B",
      "status": "rejected"
    },
    "I1": {
      "id": "I1",
      "kind": "insight",
      "label": "Procurement's €3.0M a year applies 12% to the full €25M, including €1.1M of rush freight the price cut does not touch: the real gross saving of the full move is €2.87M a year, and €7.80M over 2026-2028 after the €0.8M switching cost"
    },
    "I2": {
      "id": "I2",
      "kind": "insight",
      "label": "Supplier B runs a single plant and stopped twice in three years (9 and 14 days); with all volume on it, a repeat would cost €4.0M of gross margin, more than the €2.93M the full move earns over a 70/30 split in 2026-2028, because the incumbent can only cover up to 60% of volume at two weeks' notice"
    },
    "I3": {
      "id": "I3",
      "kind": "insight",
      "label": "A 70/30 split (Supplier B 9% on 70% of volume, incumbent 4% on the 30% it keeps) saves €1.79M a year and €4.88M over 2026-2028 after €0.5M switching, against €3.80M for the full move once a repeat of Supplier B's stoppages is counted"
    },
    "I4": {
      "id": "I4",
      "kind": "insight",
      "label": "Rush freight is our forecasting problem, not a supplier problem: €0.65M of the €1.1M (59%) sits in months the invoices flag as 'our forecast errors', and neither supplier offer reduces it"
    },
    "GT": {
      "id": "GT",
      "kind": "governing_thought",
      "label": "Reject the 100% move to Supplier B and approve a 70/30 split instead: the full move's real saving is €2.87M a year, not €3.0M, and a repeat of Supplier B's two stoppages (€4.0M) would wipe out the €2.93M it adds over the split, which saves €1.79M a year, nets €4.88M over 2026-2028 and keeps a second plant."
    },
    "K1": {
      "id": "K1",
      "kind": "key_line",
      "label": "Procurement's €3.0M a year is overstated: 12% cannot apply to €1.1M of rush freight, so the full move saves €2.87M a year gross, €7.80M over 2026-2028 after €0.8M switching"
    },
    "K2": {
      "id": "K2",
      "kind": "key_line",
      "label": "Single-sourcing on Supplier B's one plant is the bigger issue: its two stoppages in three years would cost €4.0M with all volume on it, more than the €2.93M the full move adds over a 70/30 split"
    },
    "K3": {
      "id": "K3",
      "kind": "key_line",
      "label": "A 70/30 split saves €1.79M a year and nets €4.88M over 2026-2028, ahead of the full move's €3.80M once stoppage risk is counted"
    },
    "K4": {
      "id": "K4",
      "kind": "key_line",
      "label": "The remaining gap to €3.0M sits in our own forecasting: €0.65M of €1.1M rush freight falls in months flagged as our forecast errors"
    },
    "SL:S1": {
      "id": "SL:S1",
      "kind": "slide",
      "label": "Packaging supplier consolidation: is a single supplier worth it?",
      "priority": "core",
      "reason": "Opens the board item"
    },
    "SL:S2": {
      "id": "SL:S2",
      "kind": "slide",
      "label": "Reject the 100% move to Supplier B and approve a 70/30 split: €1.79M a year, €4.88M net over 2026-2028, with a second plant kept",
      "priority": "core",
      "reason": "Board members read the answer first"
    },
    "SL:S3": {
      "id": "SL:S3",
      "kind": "slide",
      "label": "Procurement's €3.0M a year is really €2.87M: the 12% cut cannot apply to €1.1M of rush freight",
      "priority": "core",
      "reason": "Shows the proposal's arithmetic does not hold before any risk is counted"
    },
    "SL:S4": {
      "id": "SL:S4",
      "kind": "slide",
      "label": "Supplier B's single plant stopped twice in three years; a repeat would cost €4.0M, more than the €2.93M the full move adds over a 70/30 split",
      "priority": "core",
      "reason": "This is the trade-off that decides between full and partial consolidation"
    },
    "SL:S5": {
      "id": "SL:S5",
      "kind": "slide",
      "label": "A 70/30 split nets €4.88M over 2026-2028, ahead of €3.80M for the full move once stoppage risk is counted",
      "priority": "core",
      "reason": "Gives the board the approvable alternative with each option costed"
    },
    "SL:S6": {
      "id": "SL:S6",
      "kind": "slide",
      "label": "The gap to €3.0M is ours to close: €0.65M of €1.1M rush freight falls in months flagged as our own forecast errors",
      "priority": "core",
      "reason": "Answers 'what about the rest of the saving?' and assigns the lever to demand planning, not procurement"
    },
    "SL:S7": {
      "id": "SL:S7",
      "kind": "slide",
      "label": "Today: reject the full move, approve the 70/30 split and €0.5M switching budget, commission the rush-freight review",
      "priority": "core",
      "reason": "Turns the recommendation into decisions with owners, gates and KPIs"
    }
